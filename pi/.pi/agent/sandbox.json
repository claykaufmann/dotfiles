{
  "enabled": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "gitlab.beta.team"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowGitConfig": true,
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "~/.config",
      "~/.local",
      "~/.nvm/versions/node/v22.17.0/lib/node_modules/@juicesharp/rpiv-pi",
      "~/.nvm/versions/node/v22.17.0/lib/node_modules/pi-sandbox",
      "~/.nvm/versions/node/v22.17.0/lib/node_modules/@earendil-works/pi-coding-agent",
      "~/.gitconfig"
    ],
    "allowWrite": [
      "/tmp",
      "/tmp/runenv",
      "/bin/ps"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
