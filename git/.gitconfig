[user]
  name = Clay Kaufmann
  email = ckaufmann@beta.team

[pull]
  rebase = false

[fetch]
  prune = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[alias]
  last = log -1 HEAD --stat
  st = status
  b = branch
  c = commit
  co = checkout
  cob = checkout -b
  ll = log --oneline
  cm = commit -m
  rv = remote -v
  d = diff
  p = push
  pu = pull
  a = add

[init]
  defaultBranch = main

[core]
  pager = delta
	excludesfile = /Users/ckaufmann/.gitignore-global
  autocrlf = input

[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta

[interactive]
  diffFilter = delta --color-only --features=interactive

[include]
	path = ~/.config/delta/catppuccin.gitconfig

[delta]
  features = decorations catppuccin-frappe
  navigate = true
  line-numbers = true
  detect-moved-lines = blocks

[diff]
  colorMoved = default

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
  line-numbers-left-style = cyan
  line-numbers-right-style = cyan
  line-numbers-minus-style = 124
  line-numbers-plus-style = 28

[merge]
  tool = meld
  conflictstyle = diff3

[push]
  autoSetupRemote = true

[includeIf "gitdir:~/beta/"]
    path = .gitconfig-work
